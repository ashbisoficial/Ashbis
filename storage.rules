rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuth() {
      return request.auth != null;
    }

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
    }

    function isPDF() {
      return request.resource.contentType == 'application/pdf';
    }

    function isImageOrPDF() {
      return isImage() || isPDF();
    }

    function maxSize(mb) {
      return request.resource.size <= mb * 1024 * 1024;
    }

    // Mismo criterio que puedeOperarComoRefugio()/puedeAccederMascota()/
    // tieneAccesoVeterinario() en firestore.rules, pero repetido acá porque
    // Storage Rules no puede "importar" las de Firestore — solo puede
    // consultarlas cruzado con firestore.get()/exists(). Necesario para que
    // un veterinario con acceso por PIN pueda subir el archivo de un examen
    // (antes esto solo miraba si el uid del archivo coincidía con el del
    // dueño, y un veterinario nunca es ese uid).
    function puedeOperarComoRefugioStorage(duenoUid) {
      return isUser(duenoUid) ||
        firestore.exists(/databases/(default)/documents/usuarios/$(duenoUid)/miembros/$(request.auth.uid));
    }

    function esColaboradorMascotaStorage(petId) {
      return isAuth() &&
        firestore.exists(/databases/(default)/documents/mascotas/$(petId)/colaboradores/$(request.auth.uid));
    }

    function puedeAccederMascotaStorage(petId) {
      let pet = firestore.get(/databases/(default)/documents/mascotas/$(petId)).data;
      return puedeOperarComoRefugioStorage(pet.uidUsuario) || esColaboradorMascotaStorage(petId);
    }

    function tieneAccesoVeterinarioStorage(petId) {
      return isAuth() &&
        firestore.exists(/databases/(default)/documents/mascotas/$(petId)/accesosVeterinario/$(request.auth.uid));
    }

    match /mascotas/{uid}/{petId}/foto/{filename} {
      allow read:          if true;
      allow create, update: if isUser(uid) && isImage() && maxSize(10);
      allow delete:        if isUser(uid);
    }

    match /mascotas/{uid}/{petId}/galeria/{filename} {
      allow read:          if true;
      allow create, update: if isUser(uid) && isImage() && maxSize(10);
      allow delete:        if isUser(uid);
    }

    match /mascotas/{uid}/{petId}/examenes/{examenId}/{filename} {
      allow read:          if puedeAccederMascotaStorage(petId) || tieneAccesoVeterinarioStorage(petId);
      allow create, update: if (puedeAccederMascotaStorage(petId) || tieneAccesoVeterinarioStorage(petId))
                            && isImageOrPDF() && maxSize(20);
      // Sin tieneAccesoVeterinarioStorage a propósito: un veterinario puede
      // subir/reemplazar el archivo de un examen, pero no borrarlo — mismo
      // criterio que en firestore.rules.
      allow delete:        if puedeAccederMascotaStorage(petId);
    }

    // PDF de una orden clínica del historial médico (ver
    // Models.HistorialMedico.Entrada.pdfUrl) — mismo criterio de acceso que
    // examenes: lo puede subir el dueño/equipo o un veterinario con acceso
    // por PIN, pero solo el dueño/equipo puede borrarlo.
    match /mascotas/{uid}/{petId}/historialMedico/{entradaId}/{filename} {
      allow read:          if puedeAccederMascotaStorage(petId) || tieneAccesoVeterinarioStorage(petId);
      allow create, update: if (puedeAccederMascotaStorage(petId) || tieneAccesoVeterinarioStorage(petId))
                            && isPDF() && maxSize(10);
      allow delete:        if puedeAccederMascotaStorage(petId);
    }

    match /mascotas/{uid}/{petId}/documentos/{filename} {
      allow read:          if isUser(uid);
      allow create, update: if isUser(uid) && isImageOrPDF() && maxSize(20);
      allow delete:        if isUser(uid);
    }

    match /usuarios/{uid}/foto/{filename} {
      allow read:          if isUser(uid);
      allow create, update: if isUser(uid) && isImage() && maxSize(5);
      allow delete:        if isUser(uid);
    }

    // Título/certificado profesional de una cuenta veterinaria, para
    // verificación manual futura. Privado: solo lo lee su dueño (todavía no
    // hay un panel de revisión de Ashbis que necesite leerlo).
    match /usuarios/{uid}/titulo/{filename} {
      allow read:          if isUser(uid);
      allow create, update: if isUser(uid) && isImageOrPDF() && maxSize(15);
      allow delete:        if isUser(uid);
    }

    // Documento legal (personería jurídica/RUT/certificado) de una cuenta de
    // refugio, para verificación manual futura — mismo criterio que
    // usuarios/{uid}/titulo: privado, solo lo lee su dueño, y el equipo de
    // Ashbis lo revisa a mano desde la consola de Storage.
    match /usuarios/{uid}/legal/{filename} {
      allow read:          if isUser(uid);
      allow create, update: if isUser(uid) && isImageOrPDF() && maxSize(15);
      allow delete:        if isUser(uid);
    }

    // Logo/timbre/firma de una cuenta veterinaria, para personalizar la
    // atención (por ejemplo, notas del historial médico que ve el dueño de
    // la mascota) — a diferencia de título/legal, esto SÍ está pensado
    // para que otras personas lo vean, no es un documento de verificación
    // privado de revisión exclusiva de Ashbis.
    match /usuarios/{uid}/personalizacion/{filename} {
      allow read:          if isAuth();
      allow create, update: if isUser(uid) && isImage() && maxSize(5);
      allow delete:        if isUser(uid);
    }

    // Fotos de publicaciones de refugio (feed público de adopción/donación).
    match /publicaciones/{uid}/{filename} {
      allow read:          if true;
      allow create, update: if isUser(uid) && isImage() && maxSize(8);
      allow delete:        if isUser(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}