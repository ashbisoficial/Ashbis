rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // El rol es autodeclarado (ver reglas de /usuarios más abajo): no es una
    // verificación de identidad real, solo evita que cuentas 'usuario'
    // normales usen las funciones de refugio.
    function esCuentaRefugio(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.get('rol', 'usuario') == 'refugio';
    }

    // ¿"auth" es parte del equipo que opera la cuenta de refugioUid?
    // (usuarios/{refugioUid}/miembros/{auth.uid} existe)
    function esMiembroDelRefugio(refugioUid) {
      return isAuth() &&
        exists(/databases/$(database)/documents/usuarios/$(refugioUid)/miembros/$(request.auth.uid));
    }

    // Dueño original de la cuenta, o miembro del equipo con rolEquipo 'admin'.
    function esAdminDelRefugio(refugioUid) {
      return isUser(refugioUid) ||
        (isAuth() &&
         get(/databases/$(database)/documents/usuarios/$(refugioUid)/miembros/$(request.auth.uid))
           .data.get('rolEquipo', 'staff') == 'admin');
    }

    // Dueño original, o cualquier miembro del equipo (admin o staff): puede
    // crear/editar mascotas, publicaciones y transferencias en nombre de la
    // cuenta de refugio. Eliminar mascotas o gestionar el equipo requiere
    // esAdminDelRefugio en cambio.
    function puedeOperarComoRefugio(refugioUid) {
      return isUser(refugioUid) || esMiembroDelRefugio(refugioUid);
    }

    // Acceso compartido a UNA mascota puntual (hogar temporal), sin ser
    // parte del equipo del refugio ni dueño.
    function esColaboradorMascota(petId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/mascotas/$(petId)/colaboradores/$(request.auth.uid));
    }

    function puedeAccederMascota(petId) {
      let pet = get(/databases/$(database)/documents/mascotas/$(petId)).data;
      return puedeOperarComoRefugio(pet.uidUsuario) || esColaboradorMascota(petId);
    }

    // ¿"auth" es un veterinario al que esta mascota le otorgó acceso a su
    // historial médico? Solo lo crea la Cloud Function validarPinVeterinario
    // (Admin SDK), después de comprobar el PIN del lado del servidor — el
    // rol autodeclarado 'veterinario' por sí solo NUNCA alcanza (ver
    // comentario en usuarios/{uid}).
    function tieneAccesoVeterinario(petId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/mascotas/$(petId)/accesosVeterinario/$(request.auth.uid));
    }

    // Puede LEER el historial médico de esta mascota: dueño/equipo/hogar
    // temporal, o un veterinario con acceso otorgado por PIN. No implica
    // poder editar vacunas/exámenes/medicamentos/citas — esos siguen
    // reservados a puedeAccederMascota.
    function puedeVerHistorialMedico(petId) {
      return puedeAccederMascota(petId) || tieneAccesoVeterinario(petId);
    }

    // Puede crear un documento cuyo uidUsuario sea el propio, o el de un
    // refugio del que forme parte el equipo.
    function ownsData() {
      return isAuth() &&
        puedeOperarComoRefugio(request.resource.data.get('uidUsuario', null));
    }

    function noLongStrings(data) {
      return !data.keys().hasAny(['__proto__', 'constructor', 'prototype']) &&
        (
          (!('nombre'    in data) || data.nombre.size()    <= 500) &&
          (!('notas'     in data) || data.notas.size()     <= 1000) &&
          (!('titulo'    in data) || data.titulo.size()    <= 500) &&
          (!('lugar'     in data) || data.lugar.size()     <= 500) &&
          (!('tipo'      in data) || data.tipo.size()      <= 200) &&
          (!('direccion' in data) || data.direccion.size() <= 500) &&
          (!('descripcion' in data) || data.descripcion.size() <= 1000) &&
          (!('texto' in data) || data.texto.size() <= 2000)
        );
    }

    match /usuarios/{uid} {
      // El dueño lee su propio perfil, y también cualquier miembro del
      // equipo de un refugio necesita leer el perfil del refugio (por
      // ejemplo nombreRefugio) para mostrarlo en el panel del refugio.
      allow read:   if isUser(uid) || esMiembroDelRefugio(uid);
      allow create: if isUser(uid) && noLongStrings(request.resource.data)
                    && request.resource.data.get('rol', 'usuario')
                       in ['usuario', 'refugio', 'veterinario']
                    // "verificado" nunca se autodeclara true al crear la
                    // cuenta — mismo motivo que en "update" más abajo.
                    && request.resource.data.get('verificado', false) == false;
      // El rol se autodeclara una sola vez, al crear la cuenta (no hay
      // verificación de que un "refugio" o "veterinario" lo sean de verdad).
      // Por eso "update" nunca puede cambiarlo: si se pudiera, cualquier
      // usuario se auto-otorgaría permisos de refugio/veterinario editando
      // su propio perfil. El acceso real a datos sensibles (historial
      // médico) no depende solo del rol, sino también del PIN por mascota.
      allow update: if isUser(uid) && noLongStrings(request.resource.data)
                    && request.resource.data.get('uid', uid) == uid
                    && request.resource.data.get('email', resource.data.get('email',''))
                       == resource.data.get('email', '')
                    && request.resource.data.get('rol', resource.data.get('rol', 'usuario'))
                       == resource.data.get('rol', 'usuario')
                    // "verificado" (antifraude de veterinarios/refugios) solo
                    // lo cambia el equipo de Ashbis a mano en Firebase
                    // Console con el Admin SDK, que ignora estas reglas — el
                    // cliente nunca puede tocarlo, en ningún sentido.
                    && request.resource.data.get('verificado', false)
                       == resource.data.get('verificado', false);
      allow delete: if false;

      // Si uid es un refugio, esta lista también funciona como "veterinarias
      // con las que trabaja el refugio": cualquiera del equipo puede VERLA,
      // pero solo la cuenta dueña puede agregar/editar/quitar — el equipo
      // opera mascotas, no la configuración del refugio.
      match /veterinariasFavoritas/{vetId} {
        allow read:   if puedeOperarComoRefugio(uid);
        allow create: if isUser(uid)
                      && request.resource.data.uidUsuario == uid
                      && noLongStrings(request.resource.data);
        allow update: if isUser(uid) && noLongStrings(request.resource.data);
        allow delete: if isUser(uid);
      }

      // Bitácora interna de ingresos/gastos del refugio (no procesa pagos:
      // ver sección 8 de los Términos). Mismo criterio de acceso que
      // mascotas/publicaciones/veterinariasFavoritas: cualquiera del equipo
      // puede cargar y ver los movimientos.
      match /movimientosFinancieros/{movId} {
        allow read:   if puedeOperarComoRefugio(uid);
        allow create: if puedeOperarComoRefugio(uid)
                      && request.resource.data.tipo in ['ingreso', 'gasto']
                      && request.resource.data.monto is number
                      && request.resource.data.monto > 0
                      && request.resource.data.monto < 1000000000
                      && request.resource.data.creadoPor == request.auth.uid
                      && noLongStrings(request.resource.data);
        allow update: if puedeOperarComoRefugio(uid)
                      && request.resource.data.tipo in ['ingreso', 'gasto']
                      && request.resource.data.monto is number
                      && request.resource.data.monto > 0
                      && request.resource.data.monto < 1000000000
                      && noLongStrings(request.resource.data);
        allow delete: if puedeOperarComoRefugio(uid);
      }

      // Chat de equipo: un solo hilo grupal por refugio (dueño + todo el
      // equipo). Los mensajes son append-only, igual que el historial
      // médico — nadie los edita ni borra, evita disputas.
      match /chatEquipo/{msgId} {
        allow read:   if puedeOperarComoRefugio(uid);
        allow create: if puedeOperarComoRefugio(uid)
                      && request.resource.data.autorUid == request.auth.uid
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && noLongStrings(request.resource.data);
        allow update: if false;
        allow delete: if false;
      }

      // Tokens de push (FCM) de los dispositivos donde el usuario inició
      // sesión. Cada doc = un token; el id del doc es el token mismo. Solo
      // el dueño los lee/escribe; las Cloud Functions que envían el push
      // usan el Admin SDK y no pasan por estas reglas.
      match /fcmTokens/{token} {
        allow read:   if isUser(uid);
        allow create, update: if isUser(uid) && noLongStrings(request.resource.data);
        allow delete: if isUser(uid);
      }

      match /publico/{docId} {
        // La ficha pública del carnet/QR la sirve la Cloud Function
        // getCarnetPublico con el Admin SDK (que ignora estas reglas), así
        // que el cliente nunca necesita leer esto directo. Si fuera "true",
        // cualquiera podría hacer un collectionGroup('publico') y descargar
        // nombre/apellido/teléfono de todos los usuarios de la app.
        allow read:   if isUser(uid);
        allow write:  if isUser(uid) && noLongStrings(request.resource.data);
      }

      // Equipo del refugio: quiénes operan esta cuenta además del dueño.
      match /miembros/{memberUid} {
        // Lectura directa de la subcolección (dueño, admin o miembro viendo
        // al resto del equipo). La lectura para collectionGroup('miembros')
        // NO se resuelve acá — ver la regla con wildcard más abajo.
        allow read: if isUser(uid) || esMiembroDelRefugio(uid) || isUser(memberUid);
        // Solo la Cloud Function aceptarInvitacionEquipo crea estos docs,
        // después de validar la invitación por email — nunca el cliente.
        allow create: if false;
        allow update: if false;
        // El dueño/admin puede sacar a cualquiera; un miembro se puede ir solo.
        allow delete: if esAdminDelRefugio(uid) || isUser(memberUid);
      }
    }

    // Las reglas anidadas de arriba (usuarios/{uid}/miembros/{memberUid}) NO
    // se aplican a consultas collectionGroup('miembros') — Firestore exige
    // una regla aparte con el patrón wildcard {path=**} para poder validar
    // ese tipo de consulta. Esta es la que usa
    // collectionGroup('miembros').where('uid','==', miUid) en getMisRefugios().
    match /{path=**}/miembros/{memberUid} {
      allow read: if resource.data.uid == request.auth.uid;
    }

    match /mascotas/{petId} {
      // Dueño original, equipo del refugio dueño, colaborador de hogar
      // temporal, o veterinario con acceso otorgado por PIN.
      allow read: if isAuth() && (
        resource.data.uidUsuario == request.auth.uid ||
        puedeOperarComoRefugio(resource.data.uidUsuario) ||
        esColaboradorMascota(petId) ||
        tieneAccesoVeterinario(petId)
      );
      allow create: if ownsData() && noLongStrings(request.resource.data);
      allow update: if isAuth()
                    && puedeOperarComoRefugio(resource.data.uidUsuario)
                    && request.resource.data.get('uidUsuario', resource.data.uidUsuario)
                       == resource.data.uidUsuario
                    && noLongStrings(request.resource.data);
      // Eliminar una mascota es más delicado que editarla: solo dueño o admin.
      allow delete: if esAdminDelRefugio(resource.data.uidUsuario);

      // Lectura extendida a puedeVerHistorialMedico (incluye veterinarios
      // con acceso por PIN): son parte del historial médico de la mascota.
      // Crear/editar/borrar sigue reservado a puedeAccederMascota — un
      // veterinario nunca modifica estos registros estructurados, solo
      // agrega notas nuevas en historialMedico.
      match /vacunas/{vacunaId} {
        allow read: if puedeVerHistorialMedico(petId);
        allow create: if puedeAccederMascota(petId) && noLongStrings(request.resource.data);
        allow update: if puedeAccederMascota(petId) && noLongStrings(request.resource.data);
        allow delete: if puedeAccederMascota(petId);
      }
      match /medicamentos/{medId} {
        allow read: if puedeVerHistorialMedico(petId);
        allow create: if puedeAccederMascota(petId) && noLongStrings(request.resource.data);
        allow update: if puedeAccederMascota(petId) && noLongStrings(request.resource.data);
        allow delete: if puedeAccederMascota(petId);
      }
      match /examenes/{examenId} {
        allow read: if puedeVerHistorialMedico(petId);
        allow create: if puedeAccederMascota(petId) && noLongStrings(request.resource.data);
        allow update: if puedeAccederMascota(petId) && noLongStrings(request.resource.data);
        allow delete: if puedeAccederMascota(petId);
      }
      match /citas/{citaId} {
        allow read: if puedeVerHistorialMedico(petId);
        allow create: if puedeAccederMascota(petId) && noLongStrings(request.resource.data);
        allow update: if puedeAccederMascota(petId) && noLongStrings(request.resource.data);
        allow delete: if puedeAccederMascota(petId);
      }
      match /documentos/{docId} {
        allow read: if puedeVerHistorialMedico(petId);
        allow create: if puedeAccederMascota(petId) && noLongStrings(request.resource.data);
        allow update: if puedeAccederMascota(petId) && noLongStrings(request.resource.data);
        allow delete: if puedeAccederMascota(petId);
      }

      // Notas de consulta, append-only: las escribe el dueño/equipo o un
      // veterinario con acceso otorgado por PIN. Nadie puede editarlas ni
      // borrarlas después de creadas — mismo criterio que chatEquipo.
      match /historialMedico/{entradaId} {
        allow read:   if puedeVerHistorialMedico(petId);
        allow create: if puedeVerHistorialMedico(petId)
                      && request.resource.data.autorUid == request.auth.uid
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && noLongStrings(request.resource.data);
        allow update: if false;
        allow delete: if false;
      }

      // Acceso de un veterinario puntual a esta mascota, otorgado al validar
      // su PIN. Solo lo crea la Cloud Function validarPinVeterinario (Admin
      // SDK) — nunca el cliente — así el PIN siempre se valida del lado del
      // servidor. El dueño/equipo puede revocarlo, o el veterinario puede
      // quitarse él mismo.
      match /accesosVeterinario/{vetUid} {
        allow read:   if puedeAccederMascota(petId) || isUser(vetUid);
        allow create: if false;
        allow update: if false;
        allow delete: if puedeAccederMascota(petId) || isUser(vetUid);
      }

      // Hogar temporal: acceso compartido a ESTA mascota, sin cambiar de
      // dueño. Solo lo crea la Cloud Function aceptarTransferencia (tipo
      // 'hogar_temporal'), nunca el cliente.
      match /colaboradores/{colabUid} {
        allow read:   if puedeAccederMascota(petId);
        allow create: if false;
        allow update: if false;
        // El refugio (dueño/equipo) puede terminar el hogar temporal, o el
        // colaborador se puede ir solo.
        allow delete: if puedeOperarComoRefugio(get(/databases/$(database)/documents/mascotas/$(petId)).data.uidUsuario)
                      || isUser(colabUid);
      }
    }

    // Igual que con miembros (línea 143): una consulta
    // collectionGroup('colaboradores').where('uid','==', uid) necesita esta
    // regla aparte con wildcard, las reglas anidadas de arriba no aplican.
    // Usa el mismo documento (mascotas/{petId}/colaboradores/{colabUid}), así
    // que solo se permite leer el propio.
    match /{path=**}/colaboradores/{colabUid} {
      allow read: if resource.data.uid == request.auth.uid;
    }

    // Igual que con colaboradores/miembros (líneas arriba): una consulta
    // collectionGroup('accesosVeterinario').where('vetUid','==', uid) para
    // que el veterinario vea "mis pacientes" necesita esta regla aparte con
    // wildcard, las reglas anidadas de mascotas/{petId} no aplican acá.
    match /{path=**}/accesosVeterinario/{vetUid} {
      allow read: if resource.data.vetUid == request.auth.uid;
    }

    match /lugares/{placeId} {
      allow read:  if isAuth();
      allow write: if isAuth() && noLongStrings(request.resource.data);
    }

    // Espejo público (antifraude) de un refugio: solo nombre, si está
    // verificado por Ashbis, y el total de donaciones que declaró en su
    // bitácora financiera. Lo mantienen al día únicamente Cloud Functions
    // (Admin SDK) a partir de usuarios/{uid} y sus movimientosFinancieros —
    // el resto del perfil (email, teléfono, dirección) sigue sin ser
    // accesible para nadie más que el dueño/equipo.
    match /refugiosPublico/{uid} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /publicaciones/{postId} {
      // Feed público de adopción/recolección/donación: lo ve cualquiera
      // (incluso sin cuenta). Publicar/editar/borrar es solo de la cuenta
      // dueña del refugio — el equipo puede ver las publicaciones desde el
      // panel del refugio, pero no gestionarlas.
      allow read: if true;
      allow create: if isUser(request.resource.data.uidAutor)
                    && esCuentaRefugio(request.resource.data.uidAutor)
                    && request.resource.data.tipo in ['adopcion', 'recoleccion', 'donacion', 'otro']
                    // Quien publica tiene que confirmar explícitamente que
                    // los datos son reales (checkbox obligatorio en el
                    // formulario) — no se puede crear la publicación sin
                    // marcarla, ni siquiera llamando a la API directo.
                    && request.resource.data.aceptaVeracidad == true
                    // expiraEn se usa para el borrado automático por TTL a
                    // los 30 días; se acepta un margen de un día para
                    // absorber diferencias de reloj entre cliente y
                    // servidor, pero no permite fijar una fecha arbitraria.
                    && request.resource.data.expiraEn > request.time + duration.value(29, 'd')
                    && request.resource.data.expiraEn < request.time + duration.value(31, 'd')
                    && noLongStrings(request.resource.data);
      // expiraEn y aceptaVeracidad quedan fijos desde la creación: si se
      // pudieran editar, un refugio podría estirar la fecha de borrado
      // indefinidamente actualizando la publicación.
      allow update: if isUser(resource.data.uidAutor)
                    && request.resource.data.uidAutor == resource.data.uidAutor
                    && request.resource.data.expiraEn == resource.data.expiraEn
                    && request.resource.data.aceptaVeracidad == resource.data.aceptaVeracidad
                    && noLongStrings(request.resource.data);
      allow delete: if isUser(resource.data.uidAutor);
    }

    match /postulaciones/{postulacionId} {
      // El postulante ve la propia; el refugio (dueño/equipo) ve las suyas.
      allow read: if isUser(resource.data.postulanteUid)
                  || puedeOperarComoRefugio(resource.data.refugioUid);

      // Cualquier usuario autenticado puede postular a una publicación de
      // adopción activa, siempre que sea realmente del refugio indicado.
      allow create: if isUser(request.resource.data.postulanteUid)
                    && request.resource.data.estado == 'pendiente'
                    && get(/databases/$(database)/documents/publicaciones/$(request.resource.data.publicacionId)).data.tipo == 'adopcion'
                    && get(/databases/$(database)/documents/publicaciones/$(request.resource.data.publicacionId)).data.activa == true
                    && get(/databases/$(database)/documents/publicaciones/$(request.resource.data.publicacionId)).data.uidAutor == request.resource.data.refugioUid
                    && noLongStrings(request.resource.data);

      // El refugio acepta o rechaza mientras siga pendiente. Aceptar NO
      // transfiere la mascota, solo habilita crear el ChatDirecto (ver más
      // abajo) — el traspaso real sigue siendo una Transferencia aparte.
      allow update: if puedeOperarComoRefugio(resource.data.refugioUid)
                    && resource.data.estado == 'pendiente'
                    && request.resource.data.estado in ['aceptada', 'rechazada']
                    && request.resource.data.postulanteUid == resource.data.postulanteUid
                    && request.resource.data.refugioUid == resource.data.refugioUid;

      // El propio postulante puede arrepentirse mientras siga pendiente.
      allow update: if isUser(resource.data.postulanteUid)
                    && resource.data.estado == 'pendiente'
                    && request.resource.data.estado == 'cancelada'
                    && request.resource.data.postulanteUid == resource.data.postulanteUid
                    && request.resource.data.refugioUid == resource.data.refugioUid;

      allow delete: if false;
    }

    // Chat directo usuario ↔ refugio, para coordinar una adopción después
    // de que el refugio acepta una postulación (mismo id que la postulación).
    match /chatsDirectos/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participantes;
      // Solo se crea al aceptar una postulación: lo crea el refugio de esa
      // postulación, y siempre con exactamente los dos participantes.
      allow create: if puedeOperarComoRefugio(request.resource.data.refugioUid)
                    && request.auth.uid in request.resource.data.participantes
                    && request.resource.data.participantes.size() == 2
                    && noLongStrings(request.resource.data);
      allow update: if false;
      allow delete: if false;

      match /mensajes/{msgId} {
        allow read: if isAuth()
                    && request.auth.uid in get(/databases/$(database)/documents/chatsDirectos/$(chatId)).data.participantes;
        allow create: if isAuth()
                      && request.auth.uid in get(/databases/$(database)/documents/chatsDirectos/$(chatId)).data.participantes
                      && request.resource.data.autorUid == request.auth.uid
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && noLongStrings(request.resource.data);
        allow update: if false;
        allow delete: if false;
      }
    }

    match /transferencias/{transferId} {
      // Un refugio (dueño o equipo) inicia la transferencia de una mascota
      // que le pertenece hacia el email de otra persona. tipo='adopcion'
      // entrega la mascota por completo; tipo='hogar_temporal' solo da
      // acceso compartido. Rechazar/cancelar es un simple cambio de estado
      // permitido por el cliente. Aceptar NUNCA lo hace el cliente: reasigna
      // uidUsuario (adopción) o crea el colaborador (hogar temporal), y eso
      // solo lo hace la Cloud Function aceptarTransferencia con el Admin
      // SDK, después de validar que quien acepta es realmente el
      // destinatario.
      function soloCambiaEstado() {
        return request.resource.data.tipo           == resource.data.tipo &&
               request.resource.data.mascotaId       == resource.data.mascotaId &&
               request.resource.data.mascotaNombre   == resource.data.mascotaNombre &&
               request.resource.data.deUid           == resource.data.deUid &&
               request.resource.data.deNombre        == resource.data.deNombre &&
               request.resource.data.paraEmail       == resource.data.paraEmail;
      }

      // paraEmail se guarda siempre en minúsculas (crearTransferencia lo
      // normaliza), pero request.auth.token.email conserva las mayúsculas
      // con las que la cuenta destinataria se registró — sin el .lower()
      // acá, cualquier cuenta con una mayúscula en su email nunca podía ver
      // (ni rechazar) las transferencias dirigidas a ella.
      allow read: if isAuth() &&
        (puedeOperarComoRefugio(resource.data.deUid) ||
         resource.data.paraEmail == request.auth.token.email.lower());

      allow create: if puedeOperarComoRefugio(request.resource.data.deUid)
                    && esCuentaRefugio(request.resource.data.deUid)
                    && request.resource.data.tipo in ['adopcion', 'hogar_temporal']
                    && request.resource.data.estado == 'pendiente'
                    && get(/databases/$(database)/documents/mascotas/$(request.resource.data.mascotaId)).data.uidUsuario
                       == request.resource.data.deUid
                    && noLongStrings(request.resource.data);

      // Rechazar: solo el destinatario, mientras siga pendiente.
      allow update: if isAuth()
                    && request.auth.token.email.lower() == resource.data.paraEmail
                    && resource.data.estado == 'pendiente'
                    && request.resource.data.estado == 'rechazada'
                    && soloCambiaEstado();

      // Cancelar: el refugio (dueño o equipo), mientras siga pendiente.
      allow update: if puedeOperarComoRefugio(resource.data.deUid)
                    && resource.data.estado == 'pendiente'
                    && request.resource.data.estado == 'cancelada'
                    && soloCambiaEstado();

      allow delete: if false;
    }

    match /invitacionesEquipo/{inviteId} {
      // Un refugio (dueño o admin del equipo) invita por email a alguien a
      // sumarse a operar la cuenta. Aceptar lo resuelve la Cloud Function
      // aceptarInvitacionEquipo (crea usuarios/{refugioUid}/miembros/{uid}),
      // nunca el cliente directo.
      function soloCambiaEstadoInvitacion() {
        return request.resource.data.refugioUid    == resource.data.refugioUid &&
               request.resource.data.refugioNombre == resource.data.refugioNombre &&
               request.resource.data.paraEmail     == resource.data.paraEmail &&
               request.resource.data.rolEquipo     == resource.data.rolEquipo;
      }

      // Mismo motivo del .lower() que en transferencias más arriba: paraEmail
      // se guarda en minúsculas, request.auth.token.email no.
      allow read: if isAuth() &&
        (puedeOperarComoRefugio(resource.data.refugioUid) ||
         resource.data.paraEmail == request.auth.token.email.lower());

      allow create: if esAdminDelRefugio(request.resource.data.refugioUid)
                    && esCuentaRefugio(request.resource.data.refugioUid)
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.rolEquipo in ['admin', 'staff']
                    && noLongStrings(request.resource.data);

      // Rechazar: solo el destinatario, mientras siga pendiente.
      allow update: if isAuth()
                    && request.auth.token.email.lower() == resource.data.paraEmail
                    && resource.data.estado == 'pendiente'
                    && request.resource.data.estado == 'rechazada'
                    && soloCambiaEstadoInvitacion();

      // Cancelar: el refugio (dueño o admin), mientras siga pendiente.
      allow update: if esAdminDelRefugio(resource.data.refugioUid)
                    && resource.data.estado == 'pendiente'
                    && request.resource.data.estado == 'cancelada'
                    && soloCambiaEstadoInvitacion();

      allow delete: if false;
    }

    match /public_qr/{tipo}/tokens/{token} {
      // El escaneo público del QR (carnet/perdida) lo sirve la Cloud
      // Function getCarnetPublico con el Admin SDK, que ignora estas
      // reglas — el cliente solo necesita leer/escribir sus propios
      // tokens. Con "true" cualquiera podía listar la colección completa
      // y obtener mascotaId + ownerId de cada mascota de la app.
      allow read:   if isAuth() && resource.data.ownerId == request.auth.uid;
      allow create: if isAuth()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth()
                    && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
